# ── LLM (script writing) ───────────────────────────────────────────────
# FREE default: Groq (Llama 3.3 70B). Get a key at console.groq.com (free tier).
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=gsk_...
# Other free options (swap the three lines above):
#   Google Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash  LLM_API_KEY=<GOOGLE_GENERATIVE_AI_API_KEY>
#   OpenRouter:     LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free  LLM_API_KEY=<sk-or-...>
#   LM Studio:      LLM_BASE_URL=http://localhost:1234/v1  LLM_MODEL=<loaded model>  LLM_API_KEY=   (no key, fully offline)
# Paid, best quality: LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY below.
# Fallback chain (tried in order if the one above is rate-limited or down):
LLM2_BASE_URL=https://openrouter.ai/api/v1
LLM2_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM2_API_KEY=sk-or-v1-...
LLM3_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM3_MODEL=gemini-2.5-flash
LLM3_API_KEY=AIza...
LLM4_BASE_URL=https://openrouter.ai/api/v1
LLM4_MODEL=z-ai/glm-5.2:free
LLM4_API_KEY=${LLM2_API_KEY}
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5

# ── Channel identity (steers the script style) ────────────────────────
CHANNEL_NICHE=money, wealth, AI and side hustles - told as the RegesCore AI story
TARGET_SECONDS=50

# ── TTS: "edge" is free (Microsoft neural voices), "elevenlabs" is paid ─
TTS_PROVIDER=edge
EDGE_VOICE=en-US-AndrewMultilingualNeural
EDGE_RATE=+8%
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Captions ──────────────────────────────────────────────────────────
CAPTION_FONT=Arial
CAPTION_SIZE=96
CAPTION_OUTLINE=6
CAPTION_MARGIN_V=560
WORDS_PER_CAPTION=3

# ── Where rendered videos get a public URL (Instagram needs one) ──────
# Option A: AWS S3 (uses the standard AWS_* env vars / ~/.aws/credentials)
# S3_BUCKET=my-shorts-bucket
# S3_PREFIX=shorts/
# S3_PRESIGN_SECONDS=3600
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# Option B: any https folder you sync pipeline/output to
# PUBLIC_BASE_URL=https://cdn.example.com/shorts

# ── Optional overrides ────────────────────────────────────────────────
# OUTPUT_DIR=G:/YoutubeFaceless-Channel and social media/pipeline/output
# BACKGROUNDS_DIR=G:/YoutubeFaceless-Channel and social media/pipeline/assets/backgrounds
# FFMPEG_BIN=ffmpeg

# ── Posting (read by the n8n workflow via $env.*) ─────────────────────
# Instagram Graph API: IG Business/Creator account id + long-lived user token with instagram_content_publish
# IG_USER_ID=1784xxxxxxxxxxxxx
# IG_ACCESS_TOKEN=EAAB...
# Discord channel webhook for the "video posted" report (optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# ── Scene images (free) ───────────────────────────────────────────────
# comfyui = local Juggernaut-XL on your GPU (best). pollinations = hosted FLUX, no key. none = gradient.
IMAGE_PROVIDER=comfyui
IMAGE_FALLBACK=pollinations
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=Juggernaut-XL_v9_RunDiffusionPhoto_v2.safetensors
COMFYUI_STEPS=26

# ── TikTok (Content Posting API) ──────────────────────────────────────
# Developer app at developers.tiktok.com with Content Posting API + Login Kit, scopes video.upload video.publish.
# Until TikTok audits the app, posts must be SELF_ONLY (private). Set TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE after audit.
# TIKTOK_ACCESS_TOKEN=act....
# TIKTOK_PRIVACY=SELF_ONLY
