    {
      "parameters": {
        "jsCode": "// One summary line for the Discord report / execution log.\nconst r = $('Parse result').first().json;\nconst yt = $('YouTube: upload Short').all().map(i => i.json.id).filter(Boolean);\nlet ig = [];\ntry { ig = $('Instagram Reels Publisher').all().map(i => i.json.publish && i.json.publish.id).filter(Boolean); } catch (e) {}\nlet tt = [];\ntry { tt = $('TikTok Post').all().map(i => i.json.publishId).filter(Boolean); } catch (e) {}\nconst lines = [\n  `**${r.title}**`,\n  r.series ? `S1 E${r.series.episode} ${r.series.format}  •  Ledger $${r.series.ledger_after_usd}` : `topic: ${r.topic}`,\n  r.series ? `next: ${r.series.next_episode_seed}` : '',\n  `variants: ${r.variants.length}  •  ${r.variants[0].duration_seconds}s`,\n  yt.length ? `YouTube: https://youtube.com/shorts/${yt[0]}` : 'YouTube: skipped',\n  ig.length ? `Instagram media id: ${ig[0]}` : 'Instagram: skipped (no public video_url or disabled)',\n  tt.length ? `TikTok publish id: ${tt[0]}` : 'TikTok: skipped (no TIKTOK_ACCESS_TOKEN or disabled)',\n  `files: ${r.job_dir}`,\n];\nreturn [{ json: { content: lines.join('\\n'), title: r.title, youtube_ids: yt, instagram_ids: ig, job_dir: r.job_dir, webhookUrl: $env.DISCORD_WEBHOOK_URL || '' } }];"
