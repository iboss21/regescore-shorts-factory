        "jsCode": "// make_short.py prints one JSON line last. Merge it with the job context.\nconst out = $input.first().json;\nif (out.exitCode !== 0) {\n  throw new Error(`make_short.py failed (exit ${out.exitCode}):\\n${out.stderr}`);\n}\nconst lines = (out.stdout || '').trim().split(/\\r?\\n/);\nconst result = JSON.parse(lines[lines.length - 1]);\nconst job = $('Prepare job').first().json;\nreturn [{ json: { ...job, ...result } }];"
      },
