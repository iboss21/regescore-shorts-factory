        "videoId": "={{ $json.id.videoId || $json.id }}",
        "part": ["snippet", "statistics", "contentDetails"],
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000004",
      "name": "Get stats",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [520, 100],
      "credentials": { "youTubeOAuth2Api": { "id": "Y3YWdPzoklYK4IoW", "name": "YouTube - RegesCore AI" } }
    },
    {
      "parameters": {
        "jsCode": "// Flatten YouTube video resources into the shape analytics.py expects, then base64 for the shell.\nconst iso = (d) => { if (!d) return 0; const m = /PT(?:(\\d+)H)?(?:(\\d+)M)?(?:(\\d+)S)?/.exec(d); return m ? (+(m[1]||0))*3600 + (+(m[2]||0))*60 + (+(m[3]||0)) : 0; };\nconst rows = $input.all().map(i => i.json).filter(v => v && v.id).map(v => ({\n  id: v.id,\n  title: v.snippet?.title,\n  publishedAt: v.snippet?.publishedAt,\n  views: Number(v.statistics?.viewCount || 0),\n  likes: Number(v.statistics?.likeCount || 0),\n  comments: Number(v.statistics?.commentCount || 0),\n  duration: iso(v.contentDetails?.duration),\n}));\nconst pipelineDir = ($env.SHORTS_PIPELINE_DIR || 'G:/YoutubeFaceless-Channel and social media/pipeline').split(String.fromCharCode(92)).join('/');\nconst b64 = Buffer.from(JSON.stringify(rows), 'utf8').toString('base64');\nreturn [{ json: { count: rows.length, command: `python \"${pipelineDir}/analytics.py\" --json-b64 ${b64}` } }];"
      },
      "id": "b1000000-0000-4000-8000-000000000005",
      "name": "Shape rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 100]
    },
    {
      "parameters": { "command": "={{ $json.command }}" },
      "id": "b1000000-0000-4000-8000-000000000006",
      "name": "Update bible (analytics.py)",
